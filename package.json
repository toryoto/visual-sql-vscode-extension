{
  "name": "visual-sql",
  "displayName": "Visual SQL",
  "description": "Visual SQL Viewer for VS Code",
  "version": "0.0.5",
  "publisher": "RyotoTaga",
  "icon": "docs/visual-sql.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/toryoto/visual-sql-vscode-extension"
  },
  "keywords": [
    "sql",
    "viewer",
    "table",
    "editor"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "visual-sql-viewer",
          "name": "Visual SQL",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "visual-sql.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "visual-sql.configureDatabase",
        "title": "Visual SQL: Configure Database Connection"
      }
    ],
    "configuration": {
      "title": "Visual SQL",
      "properties": {
        "visualSql.databaseType": {
          "type": "string",
          "enum": [
            "spanner",
            "mysql",
            "postgresql"
          ],
          "default": "postgresql",
          "description": "Database type to connect to"
        },
        "visualSql.spanner.projectId": {
          "type": "string",
          "default": "",
          "description": "Google Cloud Project ID for Spanner"
        },
        "visualSql.spanner.instanceId": {
          "type": "string",
          "default": "",
          "description": "Spanner Instance ID"
        },
        "visualSql.spanner.databaseId": {
          "type": "string",
          "default": "",
          "description": "Spanner Database ID"
        },
        "visualSql.mysql.host": {
          "type": "string",
          "default": "localhost",
          "description": "MySQL host address"
        },
        "visualSql.mysql.port": {
          "type": "number",
          "default": 3306,
          "description": "MySQL port"
        },
        "visualSql.mysql.database": {
          "type": "string",
          "default": "",
          "description": "MySQL database name"
        },
        "visualSql.mysql.user": {
          "type": "string",
          "default": "",
          "description": "MySQL username"
        },
        "visualSql.postgresql.host": {
          "type": "string",
          "default": "localhost",
          "description": "PostgreSQL host address"
        },
        "visualSql.postgresql.port": {
          "type": "number",
          "default": 5432,
          "description": "PostgreSQL port"
        },
        "visualSql.postgresql.database": {
          "type": "string",
          "default": "",
          "description": "PostgreSQL database name"
        },
        "visualSql.postgresql.user": {
          "type": "string",
          "default": "",
          "description": "PostgreSQL username"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:jest:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.x",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.36.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "node-sql-parser": "5.3.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@google-cloud/spanner": "^7.15.0",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1"
  }
}
